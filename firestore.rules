rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Game writes and time-gated reads go through the authenticated server API.
    // Admin SDK access must be limited separately by IAM.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
      allow list, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
